# 共享开发环境连接模板。
# 先运行 scripts/shared-dev-tunnel.sh，再复制为不提交的本地环境文件并填写密码。
# 密码由项目负责人通过团队密码管理器分发，禁止写入 Git。

SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:13306/rigour_dev?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=rigour_app
SPRING_DATASOURCE_PASSWORD=replace-with-shared-dev-password

SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=16379
SPRING_DATA_REDIS_PASSWORD=replace-with-shared-dev-password

ROCKETMQ_NAME_SERVER=127.0.0.1:19876
ROCKETMQ_PROXY_ENDPOINT=127.0.0.1:18081

MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_CONSOLE_URL=http://127.0.0.1:19001
MINIO_ACCESS_KEY=rigour_admin
MINIO_SECRET_KEY=replace-with-shared-dev-password
