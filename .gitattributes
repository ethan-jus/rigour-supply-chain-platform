# 统一行尾：LF
* text=auto eol=lf

# Java
*.java text eol=lf diff=java
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.gradle text eol=lf

# Shell
*.sh text eol=lf

# 二进制
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.gz binary
*.db binary

# Maven Wrapper
mvnw text eol=lf
mvnw.cmd text eol=crlf
