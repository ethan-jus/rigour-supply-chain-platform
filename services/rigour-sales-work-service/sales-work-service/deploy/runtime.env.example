# Copy to a root-owned 0600 server file. Never commit real values.
SPRING_PROFILES_ACTIVE=dev
SPRING_CLOUD_NACOS_SERVER_ADDR=nacos:8848
NACOS_USERNAME=
NACOS_PASSWORD=

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/rigour_sales_work
SPRING_DATASOURCE_USERNAME=rigour_sales_work_app
SPRING_DATASOURCE_PASSWORD=
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_URL=jdbc:mysql://mysql:3306/rigour_sales_work
SPRING_FLYWAY_USER=rigour_sales_work_migrator
SPRING_FLYWAY_PASSWORD=

RIGOUR_SALES_TEMPORARY_CHECKIN_ENABLED=true
RIGOUR_SALES_TEMPORARY_CHECKIN_TENANT_ID=

SALES_RECORDING_STORAGE_TYPE=cos
SALES_RECORDING_COS_REGION=
SALES_RECORDING_COS_BUCKET=
RIGOUR_SALES_RECORDING_COS_SECRET_ID=
RIGOUR_SALES_RECORDING_COS_SECRET_KEY=
RIGOUR_SALES_RECORDING_COS_SESSION_TOKEN=

JAVA_TOOL_OPTIONS=-Xms96m -Xmx320m -XX:MaxMetaspaceSize=128m -XX:MaxDirectMemorySize=64m -XX:+ExitOnOutOfMemoryError
TZ=Asia/Shanghai
