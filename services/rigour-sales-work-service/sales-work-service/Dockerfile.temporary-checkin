FROM eclipse-temurin:21-jre-jammy@sha256:eebd356ad7358b7094758e5787a6726f332917cfd56feab6457c56dab895cdbf

RUN groupadd --gid 10001 rigour \
    && useradd --uid 10001 --gid rigour --no-create-home --shell /usr/sbin/nologin rigour

WORKDIR /app

ARG JAR_FILE=target/sales-work-service-1.0.0-SNAPSHOT.jar
COPY --chown=rigour:rigour ${JAR_FILE} /app/app.jar

USER 10001:10001
EXPOSE 26886

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
