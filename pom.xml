<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.rigour</groupId>
    <artifactId>rigour-supply-chain-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Rigour Supply Chain Platform</name>
    <description>瑞盖优选供应链平台领域化服务骨架</description>

    <modules>
        <module>platform/rigour-platform-bom</module>
        <module>shared/rigour-shared-context</module>
        <module>shared/rigour-shared-core</module>
        <module>shared/rigour-shared-logging</module>
        <module>shared/rigour-shared-audit</module>
        <module>shared/rigour-shared-idempotency</module>
        <module>shared/rigour-shared-outbox</module>
        <module>shared/rigour-shared-cache</module>
        <module>shared/rigour-shared-file</module>
        <module>platform/rigour-platform-starter</module>
        <module>services/rigour-api-gateway</module>
        <module>services/rigour-tenant-iam-service</module>
        <module>services/rigour-integration-migration-service</module>
        <module>services/rigour-merchant-crm-service</module>
        <module>services/rigour-erp-core-service</module>
        <module>services/rigour-order-center-service</module>
        <module>services/rigour-sales-work-service</module>
        <module>services/rigour-ai-agent-service</module>
        <module>services/rigour-analytics-bi-service</module>
        <module>services/rigour-hr-payroll-service</module>
        <module>services/rigour-city-operations-service</module>
        <module>services/rigour-channel-agent-service</module>
        <module>platform/rigour-architecture-tests</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>4.0.7</spring-boot.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <archunit.version>1.4.2</archunit.version>
        <testcontainers.version>2.0.5</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>rigour-platform-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>iam-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>integration-migration-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>merchant-crm-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>erp-core-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>order-center-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>sales-work-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>ai-agent-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>analytics-bi-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>hr-payroll-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>city-operations-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>channel-agent-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>rigour-shared-context</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>rigour-shared-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>rigour-shared-logging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>rigour-shared-audit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>rigour-shared-idempotency</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>rigour-shared-outbox</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>rigour-shared-cache</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rigour</groupId>
                <artifactId>rigour-shared-file</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <spring.cloud.nacos.config.enabled>false</spring.cloud.nacos.config.enabled>
                            <spring.cloud.nacos.config.import-check.enabled>false</spring.cloud.nacos.config.import-check.enabled>
                            <spring.cloud.nacos.discovery.enabled>false</spring.cloud.nacos.discovery.enabled>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-platform-boundaries</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.9,)</version>
                                </requireMavenVersion>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>com.rigour:rigour-tenant-iam-service</exclude>
                                        <exclude>com.rigour:rigour-integration-migration-service</exclude>
                                        <exclude>com.rigour:rigour-merchant-crm-service</exclude>
                                        <exclude>com.rigour:rigour-erp-core-service</exclude>
                                        <exclude>com.rigour:rigour-order-center-service</exclude>
                                        <exclude>com.rigour:rigour-sales-work-service</exclude>
                                        <exclude>com.rigour:rigour-ai-agent-service</exclude>
                                        <exclude>com.rigour:rigour-analytics-bi-service</exclude>
                                        <exclude>com.rigour:rigour-hr-payroll-service</exclude>
                                        <exclude>com.rigour:rigour-city-operations-service</exclude>
                                        <exclude>com.rigour:rigour-channel-agent-service</exclude>
                                        <exclude>com.rigour:iam-service</exclude>
                                        <exclude>com.rigour:integration-migration-service</exclude>
                                        <exclude>com.rigour:merchant-crm-service</exclude>
                                        <exclude>com.rigour:erp-core-service</exclude>
                                        <exclude>com.rigour:order-center-service</exclude>
                                        <exclude>com.rigour:sales-work-service</exclude>
                                        <exclude>com.rigour:ai-agent-service</exclude>
                                        <exclude>com.rigour:analytics-bi-service</exclude>
                                        <exclude>com.rigour:hr-payroll-service</exclude>
                                        <exclude>com.rigour:city-operations-service</exclude>
                                        <exclude>com.rigour:channel-agent-service</exclude>
                                    </excludes>
                                    <message>领域服务之间禁止直接或传递依赖，只能通过 API、事件或本地投影协作。</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
