# 仅用于本地开发。不得复制到生产、测试共享环境或提交真实凭据。
# 将占位值替换为本机随机值后另存为 .env；Compose 不提供默认密码。

LOCAL_MYSQL_ROOT_PASSWORD=replace-with-random-local-root-password
LOCAL_MYSQL_DATABASE=rigour_local
LOCAL_MYSQL_USER=replace-with-local-user
LOCAL_MYSQL_PASSWORD=replace-with-random-local-password

LOCAL_REDIS_PASSWORD=replace-with-random-local-password

# Gateway 本地路由；未设置时 application.yml 使用 localhost:26881-26891。
IAM_SERVICE_URL=http://localhost:26881
INTEGRATION_SERVICE_URL=http://localhost:26882
CRM_SERVICE_URL=http://localhost:26883
ERP_SERVICE_URL=http://localhost:26884
ORDER_SERVICE_URL=http://localhost:26885
SALES_SERVICE_URL=http://localhost:26886
AI_SERVICE_URL=http://localhost:26887
BI_SERVICE_URL=http://localhost:26888
HR_SERVICE_URL=http://localhost:26889
CITY_SERVICE_URL=http://localhost:26890
CHANNEL_SERVICE_URL=http://localhost:26891
